varnishtest "gitcache: a chunked body is never buffered, so it reaches the origin untouched and uncached"

server s1 {
	rxreq
	expect req.method == "POST"
	txresp -body "big"
} -start

varnish v1 -vcl+backend {
	import gitcache from "${vmod}";
	sub vcl_init {
		new git = gitcache.cache(scope = "t", limit = 100B);
	}
	sub vcl_recv { if (git.recv()) { return (hash); } }
	sub vcl_hash             { if (git.hash()) { return (lookup); } }
	sub vcl_backend_fetch    { git.backend_fetch(); }
	sub vcl_backend_response { if (git.backend_response()) { return (deliver); } }
	sub vcl_deliver { if (git.deliver()) { return (restart); } }
} -start

client c1 {
	txreq -req POST -url "/o/r.git/git-upload-pack" -hdr "Content-Type: application/x-git-upload-pack-request" -hdr "Transfer-Encoding: chunked"
	chunkedlen 5000
	chunkedlen 0
	rxresp
	expect resp.status == 200
	expect resp.body == "big"
} -run
