client c6 {
	txreq -req GET -url "/d/one.git/objects/pack/pack-0123456789abcdef0123456789abcdef01234567.pack" 
	rxresp
	expect resp.http.X-Hits == "0"
	txreq -req GET -url "/d/one.git/objects/pack/pack-0123456789abcdef0123456789abcdef01234567.pack" 
	rxresp
	expect resp.http.X-Hits == "1"
	txreq -req GET -url "/d/one.git/objects/pack/pack-0123456789abcdef0123456789abcdef01234567.pack" -hdr "Authorization: Basic QUFBOnQtYWxpY2U=" 
	rxresp
	expect resp.http.X-Hits == "0"
	txreq -req GET -url "/d/one.git/objects/ab/cdef0123456789abcdef0123456789abcdef01" 
	rxresp
	expect resp.http.X-Hits == "0"
	expect resp.http.X-Key == "/d/one.git/objects/ab/cdef0123456789abcdef0123456789abcdef01"
	txreq -req GET -url "/d/one.git/info/refs" 
	rxresp
	expect resp.http.X-Hits == "0"
	expect resp.http.X-Key == "/d/one.git/info/refs"
	txreq -req GET -url "/d/one.git/HEAD" 
	rxresp
	expect resp.http.X-Key == "/d/one.git/HEAD"
} -run

client c7 {
	txreq -req POST -url "/f/one.git/info/lfs/objects/batch" -hdr "Content-Type: application/vnd.git-lfs+json" -body "{\"operation\": \"download\", \"objects\": [{\"oid\": \"aa\", \"size\": 1}]}"
	rxresp
	expect resp.http.X-Key == ""
	txreq -req POST -url "/f/one.git/info/lfs/objects/batch" -hdr "X-Mode: lfs" -body "{\"operation\": \"download\", \"objects\": [{\"oid\": \"aa\", \"size\": 1}]}"
	rxresp
	expect resp.http.X-Hits == "0"
	expect resp.http.X-Key ~ "^/f/one[.]git/info/lfs/objects/batch/[0-9a-f]+$"
	txreq -req POST -url "/f/one.git/info/lfs/objects/batch" -hdr "X-Mode: lfs" -body "{\"operation\": \"download\", \"objects\": [{\"oid\": \"aa\", \"size\": 1}]}"
	rxresp
	expect resp.http.X-Hits == "1"
	txreq -req POST -url "/f/one.git/info/lfs/objects/batch" -hdr "X-Mode: lfs" -body "{\"operation\": \"download\", \"objects\": [{\"oid\": \"aa\", \"size\": 1}, {\"oid\": \"bb\", \"size\": 2}], \"transfers\": [\"lfs-standalone-file\", \"basic\", \"ssh\"]}"
	rxresp
	expect resp.http.X-Hits == "0"
	txreq -req POST -url "/f/one.git/info/lfs/objects/batch" -hdr "X-Mode: lfs" -body "{\"operation\": \"download\", \"objects\": [{\"oid\": \"bb\", \"size\": 2}, {\"oid\": \"aa\", \"size\": 1}], \"transfers\": [\"ssh\", \"lfs-standalone-file\", \"basic\"]}"
	rxresp
	expect resp.http.X-Hits == "1"
	txreq -req POST -url "/f/one.git/info/lfs/objects/batch" -hdr "X-Mode: lfs" -body "{\"operation\": \"upload\", \"objects\": [{\"oid\": \"aa\", \"size\": 1}]}"
	rxresp
	expect resp.http.X-Key == ""
	txreq -req POST -url "/f/one.git/info/lfs/locks/verify" -hdr "X-Mode: lfs" -body "{}"
	rxresp
	expect resp.http.X-Key == ""
	txreq -req GET -url "/f/one.git/info/lfs/objects/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" 
	rxresp
	expect resp.http.X-Hits == "0"
	txreq -req GET -url "/f/one.git/info/lfs/objects/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" 
	rxresp
	expect resp.http.X-Hits == "1"
	txreq -req PUT -url "/f/one.git/info/lfs/objects/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" -body "x"
	rxresp
	expect resp.http.X-Key == ""
} -run

client c8 {
	txreq -req GET -url "/repository/lfs-hosted/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" 
	rxresp
	expect resp.http.X-Hits == "0"
	expect resp.http.X-Key == "/repository/lfs-hosted.git/lfs-href/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
	txreq -req GET -url "/repository/lfs-hosted/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" 
	rxresp
	expect resp.http.X-Hits == "1"
	txreq -req GET -url "/repository/lfs-hosted/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" -hdr "Authorization: Basic QUFBOnQtYWxpY2U=" 
	rxresp
	expect resp.http.X-Hits == "0"
	txreq -req GET -url "/repository/lfs-hosted/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef?sig=aaa" 
	rxresp
	expect resp.http.X-Hits == "0"
	expect resp.http.X-Key ~ "[?]q=[0-9a-f]+$"
	txreq -req GET -url "/repository/lfs-hosted/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef?sig=aaa" 
	rxresp
	expect resp.http.X-Hits == "1"
	txreq -req GET -url "/repository/lfs-hosted/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef?sig=bbb" 
	rxresp
	expect resp.http.X-Hits == "0"
	txreq -req POST -url "/repository/lfs-hosted/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef/verify" -body "{}"
	rxresp
	expect resp.http.X-Key == ""
	txreq -req PUT -url "/repository/lfs-hosted/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" -body "x"
	rxresp
	expect resp.http.X-Key == ""
	txreq -req GET -url "/repository/lfs-hosted/not-an-oid" 
	rxresp
	expect resp.http.X-Key == ""
} -run
