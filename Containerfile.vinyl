FROM docker.io/library/debian:trixie
ARG VINYL_VERSION=9.0.2
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential autoconf automake libtool pkg-config python3 python3-docutils python3-sphinx \
      libedit-dev libncurses-dev libpcre2-dev libssl-dev zlib1g-dev curl ca-certificates git git-lfs clang llvm libclang-rt-19-dev \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; cd /tmp; \
    curl -fsSLO https://vinyl-cache.org/downloads/vinyl-cache-${VINYL_VERSION}.tgz; \
    (curl -fsSLO https://vinyl-cache.org/downloads/vinyl-cache-${VINYL_VERSION}.tgz.sha256 \
       && sha256sum -c vinyl-cache-${VINYL_VERSION}.tgz.sha256 && echo "CHECKSUM VERIFIED against published .sha256") \
       || echo "NO PUBLISHED CHECKSUM FOUND; computed sha256 follows"; \
    sha256sum vinyl-cache-${VINYL_VERSION}.tgz; \
    tar xzf vinyl-cache-${VINYL_VERSION}.tgz; cd vinyl-cache-${VINYL_VERSION}; \
    ./configure --prefix=/usr/local >/tmp/configure.log 2>&1 || (tail -30 /tmp/configure.log; exit 1); \
    make -j8 >/tmp/make.log 2>&1 || (tail -30 /tmp/make.log; exit 1); \
    make install >/dev/null; ldconfig; \
    ls /usr/local/bin /usr/local/sbin | tr '\n' ' '; echo; \
    ls /usr/local/include; \
    pkg-config --modversion vinylapi || true
RUN apt-get update && apt-get install -y --no-install-recommends stunnel4 && rm -rf /var/lib/apt/lists/*
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig LD_LIBRARY_PATH=/usr/local/lib
WORKDIR /work
